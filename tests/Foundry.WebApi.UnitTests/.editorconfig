[*.cs]

# CA1707: Remove the underscores from member name — suppressed for test projects (xUnit naming convention uses underscores)
dotnet_diagnostic.CA1707.severity = none

# CA1508: Dead code condition — suppressed to allow null-comparison tests that verify entity Equals(null) returns false
dotnet_diagnostic.CA1508.severity = none

# CA1859: Use concrete types for improved performance — suppressed so tests declare sut as the interface under test
dotnet_diagnostic.CA1859.severity = none

# CA1711: Do not end type names in EventHandler — suppressed for test handler types that implement IDomainEventHandler<T>
dotnet_diagnostic.CA1711.severity = none

# CA1002: Do not expose generic lists — suppressed for test spy types that expose received events for assertion
dotnet_diagnostic.CA1002.severity = none

# CA1054: URI-like parameters should not be strings — suppressed to allow tests that exercise invalid-string paths
dotnet_diagnostic.CA1054.severity = none
