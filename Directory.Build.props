<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>all</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <!-- Audit only direct dependencies: transitive advisories can't be fixed here until upstream bumps the pin. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <InternalsVisibleTo Include="Foundry.UnitTests" />
    <InternalsVisibleTo Include="Foundry.IntegrationTests" />
    <InternalsVisibleTo Include="Foundry.WebApi" />
  </ItemGroup>

  <!-- SQLitePCLRaw.lib.e_sqlite3 2.1.11 is a required transitive dependency of EF Core 10.0.9.
       The vulnerability is suppressed until EF Core releases a version with a non-vulnerable SQLite. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>
</Project>
