{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Workers": {
    "Image": "foundry-worker:local",
    "MaxConcurrent": 1,
    "TimeoutMinutes": 120,
    "ConfigPath": "./workers/config",
    "BranchNamingInstruction": "Use conventional branch naming",
    "SystemPromptTemplate": "You are implementing GitHub issue #{issueNumber}.\n\n{issueContent}\n\nBranch naming: {branchNamingInstruction}.",
    "ReportsPath": "./data/reports"
  },
  "Monitoring": {
    "DefaultPollIntervalSeconds": 30,
    "Accounts": [
      {
        "Name": "github-default",
        "Type": "GitHub",
        "BaseUrl": "https://api.github.com",
        "SecretKeyName": "Monitoring:Secrets:github-default"
      }
    ],
    "Repositories": [
      {
        "Slug": "karirafn/foundry",
        "AccountName": "github-default",
        "PollIntervalSeconds": null,
        "IsActive": true
      }
    ]
  }
}
