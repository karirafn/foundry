{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Workers": {
    "Image": "ghcr.io/anthropics/claude-code:latest",
    "MaxConcurrent": 3,
    "TimeoutMinutes": 120,
    "ConfigPath": "./workers/config",
    "BranchNamingInstruction": "Use conventional branch naming",
    "SystemPromptTemplate": "You are implementing GitHub issue #{issueNumber}: {title}.\n\nIssue body:\n{body}\n\nBranch naming: {branchNamingInstruction}.",
    "ReportsPath": "./data/reports"
  }
}
