FROM node:22-bookworm-slim

# Install git and curl explicitly — not present in slim variant.
# curl is required by the gh and glab install steps below.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl && rm -rf /var/lib/apt/lists/*

# Install gh (GitHub CLI) unconditionally — it is a worker prerequisite, not an optional toolchain.
# Keyring is fetched over HTTPS from cli.github.com (trust anchored to GitHub TLS); apt then
# cryptographically verifies every gh package against it via signed-by, so each installed package
# is GPG-verified. The keyring itself is intentionally not hash-pinned because GitHub rotates it
# periodically — pinning would break builds on rotation. The keyring is already in dearmored format
# and written directly (no gpg --dearmor step needed), matching
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian-ubuntu-linux-raspberry-pi-os-apt.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

# Install glab (GitLab CLI) unconditionally — it is a worker prerequisite, not an optional toolchain.
# Downloads the canonical .deb from the latest GitLab release and verifies integrity against the
# release's published checksums.txt before installing. GitLab does not publish an official apt
# repository for glab, so apt-repo install is not viable. Integrity is verified against
# checksums.txt fetched from the same canonical GitLab release over HTTPS — trust is anchored to
# gitlab.com TLS + release integrity, not an independent pinned hash (deliberate trade-off to stay
# current without manual version bumps).
RUN GLAB_VERSION=$(curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases/permalink/latest" \
        | grep -o '"tag_name":"v[^"]*"' \
        | sed 's/.*"v//;s/"//') && \
    echo "$GLAB_VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "Unexpected glab version: '$GLAB_VERSION'"; exit 1; } && \
    GLAB_TMPDIR=$(mktemp -d) && \
    curl -fsSL -o "${GLAB_TMPDIR}/glab_${GLAB_VERSION}_linux_amd64.deb" \
        "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.deb" && \
    curl -fsSL -o "${GLAB_TMPDIR}/checksums.txt" \
        "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/checksums.txt" && \
    cd "${GLAB_TMPDIR}" && \
    grep -E "^[0-9a-f]{64}  glab_${GLAB_VERSION}_linux_amd64\.deb$" checksums.txt | sha256sum -c - && \
    apt-get install -y --no-install-recommends "${GLAB_TMPDIR}/glab_${GLAB_VERSION}_linux_amd64.deb" && \
    rm -rf "${GLAB_TMPDIR}" /var/lib/apt/lists/*

# Disable telemetry and auto-update
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
ENV DISABLE_AUTOUPDATER=1

# Pin exact version to a single location — both the worker image and the login image derive
# from this base so the CLI version is enforced in one place.
RUN npm install -g @anthropic-ai/claude-code@2.1.314

# Pre-create ~/.claude and ~/.runtime owned by the built-in node user (UID 1000).
# ~/.runtime is the XDG_RUNTIME_DIR used by rootless dockerd; pre-creating it here
# is belt-and-suspenders — the entrypoint mkdir -p also suffices since node owns $HOME.
RUN mkdir -p /home/node/.claude /home/node/.runtime \
    && chown node:node /home/node/.claude /home/node/.runtime \
    && chmod 700 /home/node/.runtime
