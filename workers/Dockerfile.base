FROM node:22-bookworm-slim
LABEL dev.foundry.image=base

# Install git, curl and jq explicitly — not present in slim variant.
# curl is required by the gh and glab install steps below; jq merges host hooks in entrypoint.sh.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl jq && rm -rf /var/lib/apt/lists/*

# Install gh (GitHub CLI) unconditionally — it is a worker prerequisite, not an optional toolchain.
# Keyring is fetched over HTTPS from cli.github.com (trust anchored to GitHub TLS); apt then
# cryptographically verifies every gh package against it via signed-by, so each installed package
# is GPG-verified. The keyring itself is intentionally not hash-pinned because GitHub rotates it
# periodically — pinning would break builds on rotation. The keyring is already in dearmored format
# and written directly (no gpg --dearmor step needed), matching
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md#debian-ubuntu-linux-raspberry-pi-os-apt.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends gh && \
    rm -rf /var/lib/apt/lists/*

# Install glab (GitLab CLI) unconditionally — it is a worker prerequisite, not an optional toolchain.
# Downloads the canonical .deb from the latest GitLab release and verifies integrity against the
# release's published checksums.txt before installing. GitLab does not publish an official apt
# repository for glab, so apt-repo install is not viable. Integrity is verified against
# checksums.txt fetched from the same canonical GitLab release over HTTPS — trust is anchored to
# gitlab.com TLS + release integrity, not an independent pinned hash (deliberate trade-off to stay
# current without manual version bumps).
RUN GLAB_VERSION=$(curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases/permalink/latest" \
        | grep -o '"tag_name":"v[^"]*"' \
        | sed 's/.*"v//;s/"//') && \
    echo "$GLAB_VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+$' || { echo "Unexpected glab version: '$GLAB_VERSION'"; exit 1; } && \
    GLAB_TMPDIR=$(mktemp -d) && \
    curl -fsSL -o "${GLAB_TMPDIR}/glab_${GLAB_VERSION}_linux_amd64.deb" \
        "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_amd64.deb" && \
    curl -fsSL -o "${GLAB_TMPDIR}/checksums.txt" \
        "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/checksums.txt" && \
    cd "${GLAB_TMPDIR}" && \
    grep -E "^[0-9a-f]{64}  glab_${GLAB_VERSION}_linux_amd64\.deb$" checksums.txt | sha256sum -c - && \
    apt-get install -y --no-install-recommends "${GLAB_TMPDIR}/glab_${GLAB_VERSION}_linux_amd64.deb" && \
    rm -rf "${GLAB_TMPDIR}" /var/lib/apt/lists/*

# Disable telemetry and auto-update
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# The task-list tools (TaskCreate/TaskGet/TaskList/TaskUpdate) are off by default on current
# models; the worker prompt asks the agent to track its plan with them, and Agent Activity reads
# that task list for the dashboard's task progress. workers/tests/task_tools.bats guards this.
ENV CLAUDE_CODE_ENABLE_TODO_TOOLS=1
ENV DISABLE_AUTOUPDATER=1

# Install the Claude Code CLI from workers/package.json + package-lock.json — the single place the
# exact version is pinned, tracked by Dependabot. Both the worker image and the login image derive
# from this base, so they share that version. `npm ci` installs exactly the lockfile (and fails if it
# disagrees with the manifest); the CLI's bin directory is put on PATH so `claude` resolves as before.
COPY package.json package-lock.json /opt/claude-code/
RUN npm ci --prefix /opt/claude-code --omit=dev --no-audit --no-fund && npm cache clean --force
ENV PATH=/opt/claude-code/node_modules/.bin:$PATH

# Make npm, npx, pnpm and yarn Corepack shims so they follow the `packageManager` pin of the directory they run in,
# for any repository a worker clones. Corepack comes from /opt/claude-code (Dependabot-bumped) because Node 25+ no
# longer bundles it. The shims go in /usr/local/bin, replacing Node's bundled npm.
RUN /opt/claude-code/node_modules/.bin/corepack enable --install-directory /usr/local/bin \
    && /opt/claude-code/node_modules/.bin/corepack enable npm --install-directory /usr/local/bin
# No interactive download prompt in a run; a directory without a pin gets the npm this Corepack release names as its
# default, not a network lookup of the latest. COREPACK_HOME keeps its default under /home/node, writable when hardened.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV COREPACK_DEFAULT_TO_LATEST=0

# Pre-create ~/.claude, ~/.claude-credentials and ~/.runtime owned by the built-in node
# user (UID 1000).  ~/.claude is the container-local Claude config dir; an OAuth worker
# mounts the shared credential volume at ~/.claude-credentials (ADR 0090), and a node-owned
# mountpoint keeps the volume writable for the CLI even if a worker is the first to mount it.
# ~/.runtime is the XDG_RUNTIME_DIR used by rootless dockerd; pre-creating it here
# is belt-and-suspenders — the entrypoint mkdir -p also suffices since node owns $HOME.
RUN mkdir -p /home/node/.claude /home/node/.claude-credentials /home/node/.runtime \
    && chown node:node /home/node/.claude /home/node/.claude-credentials /home/node/.runtime \
    && chmod 700 /home/node/.runtime
